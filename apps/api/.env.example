# ---- Runtime ----
NODE_ENV=development
PORT=4000
# Pooled connection used by the app (local Docker: no pooler needed)
DATABASE_URL=postgresql://medifind:medifind_dev_only@localhost:5432/medifind
# Direct (non-pooled) connection used by `prisma migrate` (optional; falls back to DATABASE_URL)
DIRECT_DATABASE_URL=postgresql://medifind:medifind_dev_only@localhost:5432/medifind
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated browser origins allowed by CORS (the web app normally proxies, so this is a fallback)
CORS_ORIGINS=http://localhost:3000
WEB_APP_URL=http://localhost:3000
# Secure cookies default to true when NODE_ENV=production
COOKIE_SECURE=false
# COOKIE_DOMAIN=
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting)
TRUST_PROXY=1
# Optional: enables BullMQ background jobs. Without it, alert jobs run in-process.
# REDIS_URL=redis://localhost:6379

# ---- Data freshness ----
INVENTORY_AGING_HOURS=24
INVENTORY_STALE_HOURS=72

# ---- Imports ----
IMPORT_MAX_FILE_MB=2
IMPORT_MAX_ROWS=5000

# ---- Development-only demo accounts (prisma/seed.ts). Never set in production. ----
# Leave a password empty to have the seed generate and print a random one.
SEED_ADMIN_EMAIL=admin@medifind.test
SEED_ADMIN_PASSWORD=
SEED_MANAGER_EMAIL=farmacia@medifind.test
SEED_MANAGER_PASSWORD=
SEED_USER_EMAIL=perdoruesi@medifind.test
SEED_USER_PASSWORD=
